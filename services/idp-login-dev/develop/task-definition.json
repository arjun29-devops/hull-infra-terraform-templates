[
  {
    "name": "${ container_name }",
    "image": "${ image_name }",
    "essential": true,
    "portMappings": [
      {
        "containerPort": 80,
        "hostPort": 80
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "${ project_name }-${ env }",
        "awslogs-region": "ap-south-1",
        "awslogs-stream-prefix": "${ container_name }-${ env }-log"
      }
    }
  }
]
