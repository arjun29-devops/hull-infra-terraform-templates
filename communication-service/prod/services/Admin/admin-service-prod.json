[
   {
     "name": "admin-service-prod",
     "image": "7743515054768.dkr.ecr.ap-south-1.amazonaws.com/comm-svc-admin-ecr-prod:latest",
     "essential": true,
     "portMappings": [
       {
         "containerPort": 80,
         "hostPort": 80
       }
     ],
     "logConfiguration": {
       "logDriver": "awslogs",
       "options": {
         "awslogs-group": "admin-logs-prod",
         "awslogs-region": "ap-south-1",
         "awslogs-stream-prefix": "service-log"
       }
     }
   }
 ]
 